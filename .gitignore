# environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# heavy data: never commit
data/raw/
data/models/*.pt
data/models/*.joblib
data/models/*.npz
*.wav
*.flac
*.mp3

# keep these
!data/corpus/.gitkeep
!data/models/.gitkeep
!data/results/.gitkeep
!docs/assets/*.wav

# os
Thumbs.db
.DS_Store
desktop.ini

# Generated corpus. Deterministic from the seed recorded in manifest.json, so
# regenerating is one command and committing 480 churning JSON files buys
# nothing. manifest.json itself IS tracked: it is the reproducibility record.
data/corpus/calls/
data/corpus/audio/
data/uploads/

# synthesis temp files. These leaked into a commit once because the cleanup
# only ran on the success path; see neural_tts._synth_one.
*.part

# Results and fitted models are outputs, not source. Committing them meant a
# fresh clone arrived carrying four result files, and the Drive checkpointer
# read that as "evaluation already done" and skipped the one stage the Colab
# notebook exists to run. The numbers it then printed were from the checkout.
data/results/*.json
data/models/*
data/corpus/manifest.json
!data/results/.gitkeep
!data/models/.gitkeep
